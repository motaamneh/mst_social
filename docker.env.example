# Copy to .env.docker, then fill in the blank values locally.
# Use: docker compose --env-file .env.docker up --build -d --wait
# Never commit .env.docker. Do not put real credentials in this template.

# Host port. Set 8081 if IntelliJ is already using 8080.
MST_HTTP_PORT=8080

# Local interactive API docs. Set false to disable the UI and OpenAPI endpoints.
MST_API_DOCS_ENABLED=true

# Generate a password for this new Docker database, e.g. openssl rand -hex 32.
# PostgreSQL initializes it only when the database volume is first created.
MST_DB_PASSWORD=

# Your provider credential. Actual verification calls consume provider usage.
SEARCHAPI_API_KEY=

# Generate each of these independently with openssl rand -hex 32.
# Save them and reuse them across restarts; both must be 64 hex characters.
MST_VERIFICATION_KEY_V1=
MST_TENANT_API_KEY_HASH_KEY=
