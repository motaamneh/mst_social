# Configuration template for running the server from IntelliJ or the executable JAR.
# Copy these names into your IDE environment settings or copy this file to .env.
# Spring Boot does not load .env automatically; export its values or configure your IDE.
# For Docker Compose, use docker.env.example and .env.docker instead.
# Commit only this template. Keep actual passwords and keys in your local environment.

MST_DB_URL=jdbc:postgresql://localhost:5432/mst_social_db
MST_DB_USERNAME=postgres
MST_DB_PASSWORD=

# Your SearchAPI credential; eligible verification calls consume provider usage.
SEARCHAPI_API_KEY=

# Generate each key independently: openssl rand -hex 32
# Each must contain 64 hexadecimal characters. Keep them stable across restarts.
MST_VERIFICATION_KEY_V1=
MST_TENANT_API_KEY_HASH_KEY=

# Enable Swagger UI locally. Set false to disable the documentation endpoints.
MST_API_DOCS_ENABLED=true
